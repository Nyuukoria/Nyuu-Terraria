Items: {
	CopperBackpack: {
		DisplayName: Copper Backpack
		Tooltip: Adds 20 backpack slots. Equip in the Backpack slot and press V.
	}

	IronBackpack: {
		DisplayName: Iron Backpack
		Tooltip: Adds 30 backpack slots. Equip in the Backpack slot and press V.
	}

	GoldBackpack: {
		DisplayName: Gold Backpack
		Tooltip: Adds 40 backpack slots. Equip in the Backpack slot and press V.
	}

	EmeraldBackpack: {
		DisplayName: Emerald Backpack
		Tooltip: Adds 60 backpack slots. Equip in the Backpack slot and press V.
	}

	ObsidianBackpack: {
		DisplayName: Obsidian Backpack
		Tooltip: Adds 80 backpack slots. Equip in the Backpack slot and press V.
	}

	DemoniteBackpack: {
		DisplayName: Demonite Backpack
		Tooltip: Adds 100 backpack slots. Equip in the Backpack slot and press V.
	}

	GlassSlate: {
		DisplayName: Glass Slate
		Tooltip: Place 100 nearby blocks underground to create Hollowglass Reach
	}

	HollowglassOre: {
		DisplayName: Hollowglass Ore
		Tooltip: Mine in Hollowglass Reach or find in its ruin chests
	}

	HollowglassBar: {
		DisplayName: Hollowglass Bar
		Tooltip: An alloy that catches echoes of light
	}

	GlassVase: {
		DisplayName: Glass Vase
		Tooltip: Break for potions, ore, or coins
	}

	ReachLantern: {
		DisplayName: Reach Lantern
		Tooltip: A placeable lantern with turquoise light
	}

	ReachChest: {
		DisplayName: Reach Chest
		Tooltip: A 40-slot storage chest. Natural ruin chests contain supplies and a Glassbound Seal.
	}

	GlassboundSeal: {
		DisplayName: Glassbound Seal
		Tooltip: Summons Prism Sentinel in Hollowglass Reach
	}

	ResonatingBell: {
		DisplayName: Resonating Bell
		Tooltip: Summons Mourning Bell in Hollowglass Reach
	}

	PrismHeart: {
		DisplayName: Prism Heart
		Tooltip: Dropped by Prism Sentinel
	}

	ResonantClapper: {
		DisplayName: Resonant Clapper
		Tooltip: Dropped by Mourning Bell
	}

	GlassedgeBlade: {
		DisplayName: Glassedge Blade
		Tooltip: Launches a piercing glass blade
	}

	HollowchimeStaff: {
		DisplayName: Hollowchime Staff
		Tooltip: Fires a gently homing chime that pierces two enemies
	}

	ResonanceCharm: {
		DisplayName: Resonance Charm
		Tooltip: Grants 2 defense, 20 maximum mana, and 4% magic critical strike chance
	}

	PocketChime: {
		DisplayName: Pocket Chime
		Tooltip: Summons a Little Glass Bell companion
	}

	MossSlate: {
		DisplayName: Moss Slate
		Tooltip: The mossy rock found in Amber Grottos
	}

	AmberUrn: {
		DisplayName: Amber Urn
		Tooltip: Break for a chance at supplies and ore
	}

	VerdigrisOre: {
		DisplayName: Verdigris Ore
		Tooltip: Moss-stained ore from Amber Grottos
	}

	VerdigrisBar: {
		DisplayName: Verdigris Bar
		Tooltip: A sturdy early mining alloy
	}

	EmberAmberOre: {
		DisplayName: Ember Amber Ore
		Tooltip: Warm crystal ore from Amber Grottos
	}

	EmberAmberBar: {
		DisplayName: Ember Amber Bar
		Tooltip: A metal that holds the warmth of its ore
	}

	VerdigrisPickaxe: {
		DisplayName: Verdigris Pickaxe
		Tooltip: A 60% pickaxe with one extra tile of reach
	}

	GrottoLantern: {
		DisplayName: Grotto Lantern
		Tooltip: Lights nearby caves and improves mining speed
	}

	AmberheartPendant: {
		DisplayName: Amberheart Pendant
		Tooltip: Improves life regeneration and grants 2 defense
	}

	DeepheartPendant: {
		DisplayName: Deepheart Pendant
		Tooltip: Improves life regeneration, grants 5 defense and reduces damage taken by 5%
	}

	AmberflareStaff: {
		DisplayName: Amberflare Staff
		Tooltip: Fires a piercing flame that sets enemies alight
	}

	GlowcapSpore: {
		DisplayName: Glowcap Spore
		Tooltip: Summons a tiny Glowcap Firefly companion
	}

	AmberWispSeed: {
		DisplayName: Amber Wisp Seed
		Tooltip: Summons a warm, floating Amber Wisp companion
	}

	StormglassOre: {
		DisplayName: Stormglass Ore
		Tooltip: Found in cavern stone
	}

	StormglassBar: {
		DisplayName: Stormglass Bar
		Tooltip: A dark alloy with a violet sheen
	}

	FrostveilOre: {
		DisplayName: Frostveil Ore
		Tooltip: Found in underground snow and ice
	}

	FrostveilBar: {
		DisplayName: Frostveil Bar
		Tooltip: A cold blue metal
	}

	StormglassScepter: {
		DisplayName: Stormglass Scepter
		Tooltip: Fires a piercing frost arc and boosts mana regeneration while held
	}

	FrostveilBlade: {
		DisplayName: Frostveil Blade
		Tooltip: Swings an icy blade and casts a piercing frost crescent
	}

	CloudweaveBelt: {
		DisplayName: Cloudweave Belt
		Tooltip: Equip in a normal accessory slot to enable two additional Sky Trinket slots
	}

	StarfallPendant: {
		DisplayName: Starfall Pendant
		Tooltip: Increases maximum mana by 20 and magic critical strike chance by 4%
	}

	FrostveilSigil: {
		DisplayName: Frostveil Sigil
		Tooltip: Grants 2 defense and immunity to Chilled
	}

	Cloudvault: {
		DisplayName: Cloudvault
		Tooltip: A 160-slot chest. Scroll over the slots to reach the lower rows.
	}

	CloudSatchel: {
		DisplayName: Cloud Satchel
		Tooltip: Summons a flying piggy bank for access to your personal storage
	}

	SkylightOre: {
		DisplayName: Skylight Ore
		Tooltip: A pale ore found in shallow underground stone
	}

	SkylightBar: {
		DisplayName: Skylight Bar
		Tooltip: A light alloy that holds a cloud charge
	}

	CloudIdol: {
		DisplayName: Cloud Idol
		Tooltip: Summons the Nimbus Warden aboveground
	}

	WardenCore: {
		DisplayName: Warden Core
		Tooltip: A captured eye of the storm
	}

	DawnpetalStaff: {
		DisplayName: Dawnpetal Staff
		Tooltip: Fires a warm petal bolt that sets enemies alight
	}

	StormweaverStaff: {
		DisplayName: Stormweaver Staff
		Tooltip: Fires a fan of three piercing storm bolts
	}

	SkylightSaber: {
		DisplayName: Skylight Saber
		Tooltip: Scatters golden sparks and sets struck enemies alight
	}

	GlowglassLens: {
		DisplayName: Glowglass Lens
		Tooltip: Improves night vision and lights up nearby terrain
	}

	PetalBrooch: {
		DisplayName: Petal Brooch
		Tooltip: Increases magic damage by 7% and boosts mana regeneration
	}

	NimbusCharm: {
		DisplayName: Nimbus Charm
		Tooltip: Increases movement speed and jump height
	}

	WardenCrown: {
		DisplayName: Warden Crown
		Tooltip: Increases maximum mana by 20
		SetBonus: 12% reduced mana cost and 6% increased magic critical strike chance
	}

	WardenMantle: {
		DisplayName: Warden Mantle
		Tooltip: Increases magic damage by 6%
	}

	WardenGreaves: {
		DisplayName: Warden Greaves
		Tooltip: Increases movement speed by 8%
	}

	CloudBeret: {
		DisplayName: Cloud Beret
		Tooltip: Soft enough to nap in
	}

	CloudtailCoat: {
		DisplayName: Cloudtail Coat
		Tooltip: Cloud-lined vanity clothing
	}

	CloudtailTrousers: {
		DisplayName: Cloudtail Trousers
		Tooltip: Cloud-lined vanity clothing
	}

	SkylightChest: {
		DisplayName: Skylight Chest
		Tooltip: A brass-trimmed storage chest
	}

	StickyCloudyBomb: {
		DisplayName: Sticky Cloudy Bomb
		Tooltip: Sticks to surfaces. Blasts terrain and enemies while sparing players.
	}

	CloudyBomb: {
		DisplayName: Cloudy Bomb
		Tooltip: Blasts a huge hole and damages enemies. Harmless to players.
	}

	YuukisAntiFallDamageBoots: {
		DisplayName: Yuuki's Anti Fall Damage Boots
		Tooltip: Grants immunity to fall damage and leaves a soft cloud trail
	}

	WingsOfDemocloud: {
		DisplayName: Wings of Democloud
		Tooltip: Hold jump to fly and glide
	}

	StaffOfDemocloud: {
		DisplayName: Staff of Democloud
		Tooltip: Fires piercing storm-cloud comets that may split on hit. Boosts mana regeneration while held
	}
