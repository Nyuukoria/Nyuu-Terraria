		Description: A little bell follows you through the dark
	}
}

Keybinds.Backpack.DisplayName: Open Backpack
Conditions.BackpackEmpty: Backpack storage must be empty


Keybinds.QuestJournal.DisplayName: "Open Nyuu Chronicle"
Items.ChronicleJournal.Tooltip: "Open the quest journal, professions and appearance presets with J"
Items.GardenMirror.Tooltip: "Enter the Reverie pocket realm, or return home from either realm\nCannot be used during a boss fight"
Items.CrackedBellPortal.Tooltip: "Enter the Hush pocket realm, or return home from either realm\nThe Hush contains occasional jumpscares, configurable in mod settings"
Items.PrismWardrobe.Tooltip: "Right-click to save or restore three appearance presets\nPresets remember hair, colors and body appearance"
Items.PrideRibbon.Tooltip: "A cyan, pink and white pride ribbon\nLeaves a gentle trail of pride-colored sparkles when visible"
Items.MoonprismOre.Tooltip: "Mine crystal clusters beneath the Reverie orchard floor\nThree ore make one Moonprism Bar at a Furnace"
Items.MoonprismBar.Tooltip: "An iridescent alloy for early expedition equipment"
Items.EchoFragment.Tooltip: "Found in the Hush archive chest and dropped by its hostile inhabitants"
Items.PrismWingScale.Tooltip: "Dropped by the Rootbound Knight and Prism Matriarch"
Items.PrismMothStaff.Tooltip: "Fires piercing moth-light with a cyan and pink trail"
Items.MoonprismBow.Tooltip: "Turns arrows into piercing moonprism bolts"
Items.CoralBoomerang.Tooltip: "A returning crescent of polished coral"
Items.MooncapScepter.Tooltip: "Summons a friendly Mooncap to attack nearby enemies"
Items.EchoScythe.Tooltip: "Releases a spinning spectral blade"
Items.ArchiveLantern.Tooltip: "Grants night vision and a cool light around you"
Items.PrismLongcoat.Tooltip: "Embroidered atelier clothing\nEquip in the body vanity slot"
Items.PrismSkirt.Tooltip: "A long plum skirt with a cyan and pink hem\nEquip in the leg vanity slot"
Items.PrideMothCharm.Tooltip: "Summons a glowing pride moth companion"
Items.DewBerryCharm.Tooltip: "Summons a gentle Dew Fox companion"
Items.ReefShell.Tooltip: "Summons the Reefback Guardian in the Reverie"
Items.RootboundSeal.Tooltip: "Summons the Rootbound Knight in the Reverie"
Items.CrackedBellSigil.Tooltip: "Summons the Bellkeeper in the Hush\nRequires Hardmode"
Items.PrismCocoon.Tooltip: "Summons the Prism Matriarch in the Reverie\nRequires Hardmode"
Items.PrismMemorial.Tooltip: "An engravable crystal memorial\nRight-click to read or edit its message"
Items.CopperMemorial.Tooltip: "An engravable memorial with a copper plaque"
Items.ObsidianMemorial.Tooltip: "An engravable obsidian memorial with flowers"
Items.ReverieVase.Tooltip: "A decorative crystal vase for gardens and homes"
